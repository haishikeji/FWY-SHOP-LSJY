<!--pages/beerDetail/beerDetail.wxml-->
<wxs src="/utils/filter.wxs" module="filter" />

<view class="img-box">
  <swiper class="img-box-swiper" current="{{bannerIndex}}" bindchange="bindchange">
    <swiper-item class="box-swiper-item" wx:for="{{beerData.imgUrls}}" wx:key="index" bindtap="previewMedia" data-index="{{index}}">
      <image mode="widthFix" src="{{item}}"></image>
    </swiper-item>
  </swiper>
  <view class="swiper-num" wx:if="{{beerData.imgUrls.length>1}}">
    {{bannerIndex+1}}/{{beerData.imgUrls.length}}
  </view>
</view>

<view class="name-box">
  <text>{{beerData.beerInfo.beerName}}</text>
  <text>{{beerData.beerInfo.beerEnName}}</text>
</view>

<view class="card-box" style="margin: 48rpx 0 56rpx;">
  <view class="card-item">
    <image src="/static/img/maiya.png"></image>
    <text>{{beerData.beerInfo.plato?beerData.beerInfo.plato:'N/A'}}°P</text>
    <text>麦芽浓度</text>
  </view>
  <view class="card-item">
    <image src="/static/img/alcohol.png"></image>
    <text>{{beerData.beerInfo.abv?beerData.beerInfo.abv:'N/A'}}%vol</text>
    <text>酒精度</text>
  </view>
  <view class="card-item">
    <image src="/static/img/bitterness.png"></image>
    <text>{{beerData.beerInfo.ibu?beerData.beerInfo.ibu:'N/A'}} IBU</text>
    <text>苦度值</text>
  </view>
</view>
<view class="card-box" style="padding-bottom: 48rpx;border-bottom: 24rpx solid #F5F5F5;">
  <view class="card-item">
    <image src="/static/img/style.png"></image>
    <text>{{beerData.beerInfo.typeName}}</text>
    <text>精酿风格</text>
  </view>
  <view class="card-item">
    <image src="/static/img/brand.png"></image>
    <text>{{beerData.beerInfo.brewery}}</text>
    <text>酿酒厂</text>
  </view>
  <view class="card-item">
    <image src="/static/img/ad.png"></image>
    <text>{{beerData.beerInfo.place}}</text>
    <text>生产地</text>
  </view>
</view>

