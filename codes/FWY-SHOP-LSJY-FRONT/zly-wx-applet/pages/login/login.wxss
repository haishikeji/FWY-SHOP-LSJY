/* pages/login/login.wxss */
.login-box{
  width: 100vw;
  height: 100vh;
  background-color: #fff;
  position: fixed;
  top: 0;
  left: 0;
  z-index: 99999;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
}
.login-box>image:nth-child(1){
  width: 160rpx;
  height: 160rpx;
  margin-bottom: 372rpx;
}
.login-btn{
  width: 510rpx !important;
  height: 100rpx;
  background: rgba(0,0,0,0.87);
  border-radius: 25px;
  display: flex;
  flex-direction: row;
  justify-content: center;
  align-items: center;
}
button::after {
  border: none;
}
.login-btn>image:nth-child(1){
  width: 48rpx;
  height: 48rpx;
  margin-right: 16rpx;
}
.login-btn>text:nth-child(2){
  width: auto;
  height: 44rpx;
  font-size: 32rpx;
  font-family: PingFangSC-Medium, PingFang SC;
  font-weight: 500;
  color: #FFFFFF;
  line-height: 44rpx;
}